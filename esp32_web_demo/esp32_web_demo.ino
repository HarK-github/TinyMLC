/*
 * TMLC ESP32 / ESP32-S3 Live MNIST Digit Classifier Web Demo
 *
 * Runs a standalone C99 neural network (784 -> 128 -> 64 -> 10)
 * compiled by TMLC with symmetric per-tensor int8 quantization.
 *
 * Microcontroller Footprint:
 *   - Weights Flash ROM: 110,004 bytes (107.4 KB)
 *   - Peak Working SRAM: 768 bytes (ping-pong static buffers)
 *   - Dynamic Allocation: ZERO malloc / calloc / free
 *   - Inference Latency: ~1 to 2 ms on ESP32 @ 240 MHz
 */

#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>
#include "index_html.h"

extern "C" {
  #include "model.h"
}

// =========================================================================
// Configuration Settings
// =========================================================================

// 1: Standalone SoftAP hotspot (Recommended: connects directly to phone/laptop, no router needed)
// 0: Station mode (connects to an existing Wi-Fi network)
#define USE_AP_MODE 1

const char* AP_SSID = "TMLC-ESP32-MNIST";
const char* AP_PASS = "";  // Open network for instant one-tap connection

// If USE_AP_MODE is set to 0, configure your router credentials here:
const char* STA_SSID = "Your_WiFi_SSID";
const char* STA_PASS = "Your_WiFi_Password";

WebServer server(80);

// Helper: Convert hex character to integer [0..15]
static inline int hex_nibble(char c) {
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return -1;
}

// GET / - Serve the interactive web interface
void handleRoot() {
  server.sendHeader("Cache-Control", "no-cache");
  server.send(200, "text/html", INDEX_HTML);
}

// GET /info - Chip telemetry and model metadata
void handleInfo() {
  String json = "{";
  json += "\"status\":\"online\",";
  json += "\"model\":\"" + String(MODEL_NAME) + "\",";
  json += "\"architecture\":\"784 -> 128 -> 64 -> 10\",";
  json += "\"quantization\":\"int8 symmetric per-tensor\",";
  json += "\"flash_weight_bytes\":110004,";
  json += "\"ram_peak_bytes\":768,";
  json += "\"chip_model\":\"" + String(ESP.getChipModel()) + "\",";
  json += "\"cpu_freq_mhz\":" + String(ESP.getCpuFreqMHz()) + ",";
  json += "\"free_heap_bytes\":" + String(ESP.getFreeHeap());
  json += "}";
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send(200, "application/json", json);
}

// POST /predict - Run live inference on 784 inputs
void handlePredict() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Access-Control-Allow-Headers", "Content-Type");

  if (!server.hasArg("plain")) {
    server.send(400, "application/json", "{\"error\":\"Missing payload in request body\"}");
    return;
  }

  String body = server.arg("plain");
  body.trim();

  static float in_vec[MODEL_INPUT_DIM];
  bool parsed = false;

  // Case 1: Hex-encoded string (1568 hex characters = 784 bytes)
  if (body.length() >= 1568) {
    parsed = true;
    for (int i = 0; i < 784; i++) {
      int h1 = hex_nibble(body[2 * i]);
      int h2 = hex_nibble(body[2 * i + 1]);
      if (h1 < 0 || h2 < 0) {
        parsed = false;
        break;
      }
      in_vec[i] = (float)((h1 << 4) | h2) / 255.0f;
    }
  }

  // Case 2: Comma-separated values (floats [0.0..1.0] or ints [0..255])
  if (!parsed) {
    int idx = 0;
    int start = 0;
    int len = body.length();
    while (start < len && idx < 784) {
      int comma = body.indexOf(',', start);
      String token = (comma == -1) ? body.substring(start) : body.substring(start, comma);
      token.trim();
      if (token.length() > 0) {
        float val = token.toFloat();
        if (val > 1.0f) val /= 255.0f;  // normalize if 0..255 was passed
        in_vec[idx++] = val;
      }
      if (comma == -1) break;
      start = comma + 1;
    }
    if (idx == 784) parsed = true;
  }

  if (!parsed) {
    server.send(400, "application/json", "{\"error\":\"Expected 1568 hex chars or 784 comma-separated values\"}");
    return;
  }

  // Execute C99 inference generated by TMLC with microsecond performance timing
  static float out_vec[MODEL_OUTPUT_DIM];
  uint32_t t_start = micros();
  model_predict(in_vec, out_vec);
  uint32_t t_end = micros();
  uint32_t latency_us = t_end - t_start;

  // Find argmax prediction
  int pred_digit = 0;
  float max_score = out_vec[0];
  for (int i = 1; i < MODEL_OUTPUT_DIM; i++) {
    if (out_vec[i] > max_score) {
      max_score = out_vec[i];
      pred_digit = i;
    }
  }

  // Build JSON response
  String json = "{";
  json += "\"status\":\"ok\",";
  json += "\"digit\":" + String(pred_digit) + ",";
  json += "\"confidence\":" + String(max_score * 100.0f, 2) + ",";
  json += "\"latency_us\":" + String(latency_us) + ",";
  json += "\"probabilities\":[";
  for (int i = 0; i < MODEL_OUTPUT_DIM; i++) {
    json += String(out_vec[i] * 100.0f, 2);
    if (i < MODEL_OUTPUT_DIM - 1) json += ",";
  }
  json += "]}";

  Serial.printf("[Inference] Digit: %d | Conf: %.1f%% | Latency: %u us\n",
                pred_digit, max_score * 100.0f, latency_us);

  server.send(200, "application/json", json);
}

// Handle CORS preflight
void handleOptions() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Access-Control-Allow-Methods", "POST, GET, OPTIONS");
  server.sendHeader("Access-Control-Allow-Headers", "Content-Type");
  server.send(204);
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n==================================================");
  Serial.println("  TMLC ESP32 Real-Time MNIST Classifier Web Demo  ");
  Serial.println("==================================================");
  Serial.printf("Model Name      : %s\n", MODEL_NAME);
  Serial.printf("Topology        : %d -> 128 -> 64 -> %d\n", MODEL_INPUT_DIM, MODEL_OUTPUT_DIM);
  Serial.printf("Quantization    : int8 symmetric per-tensor\n");
  Serial.printf("Flash Weights   : 110,004 bytes\n");
  Serial.printf("Working RAM     : 768 bytes (static ping-pong)\n");
  Serial.println("==================================================");

#if USE_AP_MODE
  Serial.printf("[Wi-Fi] Starting SoftAP: '%s'...\n", AP_SSID);
  WiFi.mode(WIFI_AP);
  if (strlen(AP_PASS) > 0) {
    WiFi.softAP(AP_SSID, AP_PASS);
  } else {
    WiFi.softAP(AP_SSID);
  }
  IPAddress ip = WiFi.softAPIP();
  Serial.print("[Wi-Fi] Access Point Ready! IP Address: ");
  Serial.println(ip);
#else
  Serial.printf("[Wi-Fi] Connecting to '%s'...\n", STA_SSID);
  WiFi.mode(WIFI_STA);
  WiFi.begin(STA_SSID, STA_PASS);
  while (WiFi.status() != WL_CONNECTED) {
    delay(400);
    Serial.print(".");
  }
  Serial.println();
  IPAddress ip = WiFi.localIP();
  Serial.print("[Wi-Fi] Connected! IP Address: ");
  Serial.println(ip);
#endif

  // Configure Web Server routes
  server.on("/", HTTP_GET, handleRoot);
  server.on("/info", HTTP_GET, handleInfo);
  server.on("/predict", HTTP_POST, handlePredict);
  server.on("/predict", HTTP_OPTIONS, handleOptions);

  server.begin();
  Serial.println("[HTTP] Web server listening on port 80");
  Serial.printf("[HTTP] Open http://%s in your browser!\n", ip.toString().c_str());
  Serial.println("==================================================\n");
}

void loop() {
  server.handleClient();
}
