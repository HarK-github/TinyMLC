/*
 * Wokwi ESP32-S3 TinyML Simulation Demo
 * Model: Tiny (4 -> 8 -> 2), symmetric int8 weight-only quantization.
 * Auto-generated by TMLC (TinyML Model-to-C Compiler).
 */

#include <Arduino.h>

extern "C" {
  #include "model.h"
}

void printBanner(void) {
  Serial.println();
  Serial.println("==================================================");
  Serial.print("TMLC ESP32-S3 Inference Demo (Model: ");
  Serial.print(MODEL_NAME);
  Serial.println(")");
  Serial.print("Input Dimension : ");
  Serial.println(MODEL_INPUT_SIZE);
  Serial.print("Output Dimension: ");
  Serial.println(MODEL_OUTPUT_SIZE);
  Serial.println("Send comma-separated floats over Serial, e.g.:");
  Serial.println("  0.5, -0.2, 0.8, -0.4");
  Serial.println("==================================================");
}

void setup(void) {
  Serial.begin(115200);
  while (!Serial && millis() < 3000) {
    // Wait for Serial Monitor connection
  }
  delay(500);
  printBanner();
}

void processLine(String line) {
  line.trim();
  if (line.length() == 0) {
    return;
  }

  float in_vec[MODEL_INPUT_SIZE];
  int count = 0;
  int startIdx = 0;
  bool parseError = false;

  while (startIdx < (int)line.length()) {
    int commaIdx = line.indexOf(',', startIdx);
    String token;
    if (commaIdx == -1) {
      token = line.substring(startIdx);
      startIdx = line.length();
    } else {
      token = line.substring(startIdx, commaIdx);
      startIdx = commaIdx + 1;
    }
    token.trim();
    if (token.length() == 0) {
      continue;
    }

    if (count >= MODEL_INPUT_SIZE) {
      count++;
      continue;
    }

    char *endptr = NULL;
    float val = strtof(token.c_str(), &endptr);
    if (endptr == token.c_str() || (*endptr != '\0' && !isspace((unsigned char)*endptr))) {
      Serial.print("Error: Invalid numeric input token '");
      Serial.print(token);
      Serial.println("'");
      parseError = true;
      break;
    }
    in_vec[count++] = val;
  }

  if (parseError) {
    return;
  }

  // Validate exact input count
  if (count != MODEL_INPUT_SIZE) {
    Serial.print("Error: Input count mismatch. Expected ");
    Serial.print(MODEL_INPUT_SIZE);
    Serial.print(" values, got ");
    Serial.println(count);
    return;
  }

  // Execute inference on the parsed input
  float out_vec[MODEL_OUTPUT_SIZE];
  unsigned long start_us = micros();
  model_predict(in_vec, out_vec);
  unsigned long end_us = micros();
  unsigned long duration_us = end_us - start_us;

  // Determine predicted class (argmax)
  int pred_class = 0;
  float max_score = out_vec[0];
  for (int i = 1; i < MODEL_OUTPUT_SIZE; i++) {
    if (out_vec[i] > max_score) {
      max_score = out_vec[i];
      pred_class = i;
    }
  }

  // Print results
  Serial.print("Predicted class: ");
  Serial.println(pred_class);
  Serial.print("Inference time: ");
  Serial.print(duration_us);
  Serial.println(" us");
  Serial.print("Outputs: [");
  for (int i = 0; i < MODEL_OUTPUT_SIZE; i++) {
    Serial.print(out_vec[i], 6);
    if (i + 1 < MODEL_OUTPUT_SIZE) {
      Serial.print(", ");
    }
  }
  Serial.println("]");
  Serial.println("--------------------------------------------------");
}

void loop(void) {
  if (Serial.available() > 0) {
    String line = Serial.readStringUntil('\n');
    processLine(line);
  }
}
